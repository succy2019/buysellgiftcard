# DFQ Exchange — environment template
# Copy to .env and fill in the real values. Never commit .env to git.

# --- Database (cPanel usually prefixes names, e.g. cpaneluser_dfqexchange) ---
DFQ_DB_HOST=localhost
DFQ_DB_NAME=cpuser_dfqexchange
DFQ_DB_USER=cpuser_dfq
DFQ_DB_PASS=change-me

# --- Application ---
DFQ_APP_URL=https://dfqexchange.com.ng
DFQ_PRODUCTION=1
DFQ_TIMEZONE=Africa/Lagos

# --- Encryption ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Set this once at launch and never change it afterwards.
DFQ_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
