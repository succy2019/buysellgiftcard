# DFQ Exchange — environment template
# Copy to .env and fill in the real values. Never commit .env to git.

# --- Database (cPanel usually prefixes names, e.g. cpaneluser_dfqexchange) ---
DFQ_DB_HOST=localhost
DFQ_DB_NAME=cpuser_dfqexchange
DFQ_DB_USER=cpuser_dfq
DFQ_DB_PASS=change-me

# --- Application ---
DFQ_APP_URL=https://dfqexchange.com.ng
DFQ_PRODUCTION=1
DFQ_TIMEZONE=Africa/Lagos

# --- Encryption ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Set this once at launch and never change it afterwards.
DFQ_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# --- Email ---
# smtp = authenticated SMTP (recommended), mail = PHP mail(), log = local file.
DFQ_MAIL_TRANSPORT=smtp
DFQ_MAIL_FROM=no-reply@dfqexchange.com.ng
DFQ_MAIL_FROM_NAME=DFQ Exchange
DFQ_MAIL_REPLY_TO=support@dfqexchange.com.ng
DFQ_SUPPORT_EMAIL=support@dfqexchange.com.ng
DFQ_ADMIN_NOTIFY_EMAIL=support@dfqexchange.com.ng

# cPanel email accounts usually use mail.<domain> with SSL on port 465
# (or STARTTLS on port 587).
DFQ_SMTP_HOST=mail.dfqexchange.com.ng
DFQ_SMTP_PORT=465
DFQ_SMTP_USER=no-reply@dfqexchange.com.ng
DFQ_SMTP_PASS=change-me
DFQ_SMTP_SECURE=ssl
