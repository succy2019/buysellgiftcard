# DFQ Exchange — Apache hardening
Options -Indexes

# Never serve dotfiles (e.g. .env, .git)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct web access to application internals
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|database)(/|$) - [F,L]
</IfModule>

# Setup and migration scripts are CLI-only
<FilesMatch "^(setup_database|migrate)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Basic security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
